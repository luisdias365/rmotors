<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>R Motors – Seminovos</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,500;0,700;1,700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f4ef;--card:#fff;--tx:#141416;--mu:#6b6b72;--gold:#d99a14;--wine:#961818;--bd:#e3dfd5;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e0e10;--card:#18181b;--tx:#f4f4f5;--mu:#a1a1aa;--gold:#f5b52e;--bd:#2a2a2e}}
:root[data-theme="dark"]{--bg:#0e0e10;--card:#18181b;--tx:#f4f4f5;--mu:#a1a1aa;--gold:#f5b52e;--bd:#2a2a2e}
html{scroll-padding-top:env(safe-area-inset-top,0px)}*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:Poppins,system-ui,-apple-system,Segoe UI,sans-serif}
header{display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:3px solid var(--gold);background:#0e0e10;color:#fff}
header img{width:56px;height:auto;border-radius:10px;border:2px solid #fff}header b{font-size:20px;font-style:italic}header small{display:block;color:#f5b52e;font-size:12px}
.hero{padding:34px 20px 22px;max-width:1100px;margin:auto}.hero h1{margin:0 0 6px;font-size:clamp(26px,5vw,42px);font-style:italic}.hero p{margin:0;color:var(--mu)}
.bar{max-width:1100px;margin:auto;padding:0 20px 14px;display:flex;flex-wrap:wrap;gap:10px}
.bar input,.bar select{flex:1 1 180px;padding:12px 14px;border-radius:12px;border:1px solid var(--bd);background:var(--card);color:var(--tx);font:inherit}
.chips{max-width:1100px;margin:auto;padding:0 20px 18px;display:flex;gap:8px;overflow-x:auto}
.chips button{flex:none;padding:8px 14px;border-radius:99px;border:1px solid var(--bd);background:var(--card);color:var(--tx);font:inherit;font-size:14px;cursor:pointer}
.chips button.on{background:var(--gold);color:#141416;border-color:var(--gold);font-weight:700}
.count{max-width:1100px;margin:auto;padding:0 20px 10px;color:var(--mu);font-size:14px}
.grid{max-width:1100px;margin:auto;padding:0 20px 40px;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:18px;overflow:hidden;display:flex;flex-direction:column}
.ph{aspect-ratio:4/3;background:linear-gradient(135deg,#1b1b1f,#3a2f12);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#f5b52e;font-style:italic;font-weight:700}
.ph span{font-size:54px;line-height:1}.ph small{font-size:12px;color:#c9c9cf;font-weight:500;font-style:normal;margin-top:6px}
.in{padding:14px 16px 16px;display:flex;flex-direction:column;gap:4px;flex:1}.in em{color:var(--mu);font-style:normal;font-size:13px}
.in h3{margin:0;font-size:18px}.tags{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}.tags i{font-style:normal;font-size:12px;background:var(--wine);color:#fff;border-radius:99px;padding:3px 10px}
.pr{font-weight:700;color:var(--gold);margin-top:auto}
.wa{margin-top:8px;display:block;text-align:center;background:#1fa855;color:#fff;text-decoration:none;font-weight:700;padding:11px;border-radius:12px}
footer{background:#0e0e10;color:#d4d4d8;text-align:center;padding:28px 20px calc(28px + env(safe-area-inset-bottom,0px));font-size:15px}footer b{color:#f5b52e}
.card{cursor:pointer;position:relative}.ph img{width:100%;height:100%;object-fit:cover}.ph{overflow:hidden}
.sold{position:absolute;top:12px;left:-30px;background:var(--wine);color:#fff;font-weight:700;font-size:13px;padding:4px 40px;transform:rotate(-35deg);z-index:2}
.ov{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9;overflow:auto;padding:max(14px,env(safe-area-inset-top,0px)) 14px 30px}.ov.on{display:block}
.bx{max-width:640px;margin:auto;background:var(--card);border-radius:18px;padding:16px;border:1px solid var(--bd)}
.bx .big{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px;background:#222}.th{display:flex;gap:6px;overflow-x:auto;margin:8px 0}.th img{width:70px;height:54px;object-fit:cover;border-radius:8px;cursor:pointer;flex:none}
.x{float:right;background:none;border:0;color:var(--tx);font-size:26px;cursor:pointer}
.fm label{display:block;font-size:13px;color:var(--mu);margin-top:10px}.fm input,.fm select{width:100%;padding:10px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);font:inherit}
.btn{padding:11px 16px;border-radius:12px;border:0;background:var(--gold);color:#141416;font:inherit;font-weight:700;cursor:pointer}.btn.r{background:var(--wine);color:#fff}
.edb{position:sticky;top:0;z-index:5;background:var(--wine);color:#fff;padding:10px 16px;display:none;gap:10px;align-items:center;flex-wrap:wrap}.edb.on{display:flex}.edb span{flex:1;font-weight:700}
.ph2{position:relative}.ph2 button{position:absolute;top:2px;right:2px;border:0;border-radius:50%;width:22px;height:22px;background:#961818;color:#fff;cursor:pointer}
</style></head><body>
<div class="edb" id="eb"><span>Modo editor</span><button class="btn" id="nw">+ Novo carro</button><button class="btn" id="dl">Baixar site atualizado</button></div>
<header><img src="data:image/jpeg;base64," alt="R Motors"><div><b>R Motors</b><small>Aqui, confiança não é promessa. É padrão.</small></div></header>
<section class="hero"><h1>Nosso estoque</h1><p>Seminovos revisados. Chame no WhatsApp e agende sua visita.</p></section>
<div class="bar"><input id="q" placeholder="Buscar modelo…" type="search"><select id="s"><option value="y">Mais novos primeiro</option><option value="o">Mais antigos primeiro</option><option value="a">Ordem A–Z</option></select></div>
<div class="chips" id="chips"></div><div class="count" id="n"></div><main class="grid" id="g"></main>
<footer><b>R Motors</b><br>R. Santa Isabel, 235<br>WhatsApp (16) 99656-1507</footer>
<div class="ov" id="m"></div><div class="ov" id="f"></div>
<script id="data" type="application/json">[{"b": "Volkswagen", "m": "Amarok", "y": 2014, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Honda", "m": "HR-V", "y": 2023, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Honda", "m": "HR-V", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Toyota", "m": "Corolla", "y": 2021, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Toyota", "m": "Corolla", "y": 0, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Chevrolet", "m": "S10", "y": 1998, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "Nivus", "y": 2022, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "Nivus", "y": 2024, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "BMW", "m": "X1", "y": 2013, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "Polo", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "Polo", "y": 2026, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "Polo Track", "y": 2026, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Kia", "m": "Sportage", "y": 2018, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Toro", "y": 2017, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Toro", "y": 2023, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Toro", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Honda", "m": "City", "y": 2015, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Nissan", "m": "Kicks", "y": 2019, "v": "SV", "g": "Automático", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Nissan", "m": "Kicks", "y": 2024, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Nissan", "m": "Kicks", "y": 2026, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Nissan", "m": "Versa", "y": 2014, "v": "", "g": "Manual", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Pulse", "y": 0, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Pulse Abarth", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "T-Cross", "y": 2022, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "T-Cross", "y": 2024, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "T-Cross", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Chery", "m": "Arrizo 6", "y": 2023, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Hyundai", "m": "HB20", "y": 2024, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Strada", "y": 2015, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Strada", "y": 2021, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Chevrolet", "m": "Onix", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Chevrolet", "m": "Onix Plus", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "Tera", "y": 2026, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "Tera", "y": 2026, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Jeep", "m": "Compass", "y": 2018, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Jeep", "m": "Renegade", "y": 2016, "v": "Longitude", "g": "Automático", "f": "", "p": "", "x": "Teto solar", "s": 0, "ph": []}, {"b": "Renault", "m": "Kardian", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Chevrolet", "m": "Montana", "y": 2024, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Chevrolet", "m": "Montana", "y": 2025, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Argo Trekking", "y": 2021, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Chevrolet", "m": "Tracker", "y": 2022, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Fiat", "m": "Fastback", "y": 2023, "v": "", "g": "", "f": "", "p": "", "x": "", "s": 0, "ph": []}, {"b": "Volkswagen", "m": "Virtus", "y": 2019, "v": "MSI", "g": "Automático", "f": "", "p": "", "x": "", "s": 0, "ph": []}]</script>
<script>
const WA="5516996561507",D=JSON.parse(document.getElementById("data").textContent),$=i=>document.getElementById(i);
let b="Todas",ph=[],cur=-1;const ed=()=>location.hash=="#editor";
const nm=c=>c.b+" "+c.m+(c.y?" "+c.y:"");
const wa=c=>'<a class="wa" target="_blank" rel="noopener" href="https://wa.me/'+WA+'?text='+encodeURIComponent("Olá! Tenho interesse no "+nm(c))+'">Tenho interesse</a>';
const tags=c=>[c.v,c.g,c.f,c.x].filter(Boolean).map(v=>"<i>"+v+"</i>").join("");
const pr=c=>c.p?"R$ "+c.p:"Consulte o valor";
function draw(){const t=$("q").value.toLowerCase(),o=$("s").value;
$("eb").className="edb"+(ed()?" on":"");
const brands=["Todas",...new Set(D.map(x=>x.b))].sort((a,c)=>a=="Todas"?-1:a.localeCompare(c));
$("chips").innerHTML=brands.map(x=>'<button class="'+(x==b?"on":"")+'">'+x+"</button>").join("");
let l=D.map((c,i)=>[c,i]).filter(([c])=>(b=="Todas"||c.b==b)&&(c.b+" "+c.m).toLowerCase().includes(t));
l.sort(([a],[c])=>o=="a"?(a.b+a.m).localeCompare(c.b+c.m):o=="o"?(a.y||9999)-(c.y||9999):(c.y||0)-(a.y||0));
$("n").textContent=l.length+" veículo"+(l.length==1?"":"s");
$("g").innerHTML=l.map(([c,i])=>'<article class="card" data-i="'+i+'">'+(c.s?'<div class="sold">VENDIDO</div>':"")+'<div class="ph">'+(c.ph[0]?'<img src="'+c.ph[0]+'" alt="'+nm(c)+'">':"<span>"+c.b[0]+"</span><small>Fotos no WhatsApp</small>")+'</div><div class="in"><em>'+c.b+"</em><h3>"+c.m+(c.y?" · "+c.y:"")+'</h3><div class="tags">'+tags(c)+'</div><div class="pr">'+pr(c)+"</div>"+(ed()?'<button class="btn" data-e="'+i+'">Editar</button>':c.s?"":wa(c))+"</div></article>").join("")}
function det(i){const c=D[i];$("m").innerHTML='<div class="bx"><button class="x" data-c="m">×</button><h3>'+nm(c)+'</h3>'+(c.ph[0]?'<img class="big" id="bg" src="'+c.ph[0]+'"><div class="th">'+c.ph.map(p=>'<img src="'+p+'" data-p="1">').join("")+"</div>":"")+'<div class="tags">'+tags(c)+'</div><div class="pr">'+pr(c)+"</div>"+(c.s?"":wa(c))+"</div>";$("m").className="ov on"}
function form(i){cur=i;const c=i<0?{b:"",m:"",y:"",v:"",g:"",f:"",p:"",x:"",s:0,ph:[]}:D[i];ph=[...c.ph];
const f=(id,l,v)=>'<label>'+l+'<input id="'+id+'" value="'+String(v).replace(/"/g,"&quot;")+'"></label>';
const sel=(id,l,v,o)=>'<label>'+l+'<select id="'+id+'">'+["",...o].map(x=>'<option'+(x==v?" selected":"")+">"+x+"</option>").join("")+"</select></label>";
$("f").innerHTML='<div class="bx fm"><button class="x" data-c="f">×</button><h3>'+(i<0?"Novo carro":"Editar carro")+"</h3>"+f("fb","Marca",c.b)+f("fm","Modelo",c.m)+f("fy","Ano",c.y)+f("fv","Versão",c.v)+sel("fg","Câmbio",c.g,["Manual","Automático"])+sel("ff","Combustível",c.f,["Flex","Gasolina","Diesel","Híbrido","Elétrico"])+f("fp","Preço (só números, ex.: 60.000)",c.p)+f("fx","Destaque (ex.: Teto solar)",c.x)+'<label><input type="checkbox" id="fs" style="width:auto"'+(c.s?" checked":"")+'> Vendido</label><label>Fotos (a primeira é a capa)<input type="file" id="fi" accept="image/*" multiple></label><div class="th" id="ft"></div><p><button class="btn" id="sv">Salvar</button> '+(i<0?"":'<button class="btn r" id="rm">Excluir</button>')+"</p></div>";$("f").className="ov on";thumbs()}
function thumbs(){$("ft").innerHTML=ph.map((p,k)=>'<div class="ph2"><img src="'+p+'" data-k="'+k+'"><button data-d="'+k+'">×</button></div>').join("")}
function rs(f){return new Promise(r=>{const i=new Image();i.onload=()=>{const k=Math.min(1,800/Math.max(i.width,i.height)),c=document.createElement("canvas");c.width=i.width*k;c.height=i.height*k;c.getContext("2d").drawImage(i,0,0,c.width,c.height);URL.revokeObjectURL(i.src);r(c.toDataURL("image/jpeg",.72))};i.onerror=()=>r(null);i.src=URL.createObjectURL(f)})}
function save(){const v=id=>$(id).value.trim(),c={b:v("fb"),m:v("fm"),y:+v("fy")||0,v:v("fv"),g:v("fg"),f:v("ff"),p:v("fp"),x:v("fx"),s:$("fs").checked?1:0,ph};if(!c.b||!c.m){alert("Preencha marca e modelo");return}cur<0?D.push(c):D[cur]=c;$("f").className="ov";draw()}
function exp(){const h=document.documentElement.cloneNode(true);h.querySelector("#data").textContent=JSON.stringify(D).replace(/</g,"\\u003c");["g","chips","n","m","f"].forEach(i=>h.querySelector("#"+i).innerHTML="");["m","f"].forEach(i=>h.querySelector("#"+i).className="ov");h.querySelector("#eb").className="edb";const a=document.createElement("a");a.href=URL.createObjectURL(new Blob(["<!DOCTYPE html>\n"+h.outerHTML],{type:"text/html"}));a.download="index.html";a.click()}
document.addEventListener("click",async e=>{const t=e.target,d=t.dataset;
if(t.closest("#chips")&&t.tagName=="BUTTON"){b=t.textContent;draw();return}
if(d.e!==undefined){form(+d.e);return}if(d.c){$(d.c).className="ov";return}
if(d.p){$("bg").src=t.src;return}if(d.d!==undefined){ph.splice(+d.d,1);thumbs();return}
if(d.k!==undefined){const k=+d.k;ph.unshift(ph.splice(k,1)[0]);thumbs();return}
if(t.id=="sv"){save();return}if(t.id=="rm"){if(confirm("Excluir este carro?")){D.splice(cur,1);$("f").className="ov";draw()}return}
if(t.id=="nw"){form(-1);return}if(t.id=="dl"){exp();return}
const cd=t.closest(".card");if(cd&&!t.closest("a")&&!ed())det(+cd.dataset.i)});
document.addEventListener("change",async e=>{if(e.target.id=="fi"){for(const f of e.target.files){const p=await rs(f);if(p)ph.push(p)}thumbs();e.target.value=""}});
$("q").oninput=draw;$("s").onchange=draw;window.onhashchange=draw;draw();
</script></body></html>
